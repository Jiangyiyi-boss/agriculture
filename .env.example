# ===== 生产环境配置 =====
# 复制此文件为 .env 后填写真实值

# MySQL（docker-compose 会用这个密码初始化 MySQL）
MYSQL_ROOT_PASSWORD=换成强密码

# PostgreSQL（docker-compose 会用这个密码初始化 PG）
PG_PASSWORD=换成强密码

# JWT
SECRET_KEY=换成长随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 短信
SMS_PROVIDER=aliyun
SMS_CODE_TTL_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_HOURLY_LIMIT=5
SMS_DAILY_LIMIT=10
ALIYUN_ACCESS_KEY_ID=你的阿里云AK
ALIYUN_ACCESS_KEY_SECRET=你的阿里云SK
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=你的短信签名
ALIYUN_SMS_SCHEME_NAME=你的方案名
ALIYUN_SMS_TEMPLATE_LOGIN=100001
ALIYUN_SMS_TEMPLATE_REGISTER=100001
ALIYUN_SMS_TEMPLATE_RESET=100003

# 高德
AMAP_API_KEY=你的高德Web服务Key
AMAP_SECURITY_KEY=你的高德安全密钥

# 和风天气
QWEATHER_API_KEY=你的和风Key
QWEATHER_API_HOST=你的和风Host

# AI
QWEN_VL_API_KEY=你的Qwen VL Key
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max
DEEPSEEK_API_KEY=你的DeepSeek Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
TAVILY_API_KEY=你的Tavily Key
AI_IMAGE_MAX_MB=5
AI_IMAGE_MAX_COUNT=5
AI_REDIS_TTL_SECONDS=86400
AI_REDIS_MAX_ROUNDS=10

# BGE-M3
BGE_M3_MODEL_PATH=backend/models/bge-m3
BGE_M3_DEVICE=cpu
EMBEDDING_DIM=1024
BGE_M3_BATCH_SIZE=16
BGE_M3_MAX_LENGTH=512
MILVUS_COLLECTION_PEST=pest_knowledge
PEST_RAG_SCORE_THRESHOLD=0.55
PEST_RAG_TOP_K=5

# 服务器
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# 前端
VITE_AMAP_WEB_KEY=你的高德Web端Key
VITE_AMAP_SECURITY_CODE=你的高德安全密钥
