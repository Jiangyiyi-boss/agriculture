# Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pg_agent
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMS: console for local development, aliyun for real SMS
SMS_PROVIDER=aliyun
SMS_CODE_TTL_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_HOURLY_LIMIT=5
SMS_DAILY_LIMIT=10

# Alibaba Cloud credentials: do not commit real values
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_SCHEME_NAME=
ALIYUN_SMS_TEMPLATE_LOGIN=100001
ALIYUN_SMS_TEMPLATE_REGISTER=100001
ALIYUN_SMS_TEMPLATE_RESET=100003

# AMap Web Service credentials: do not commit real values
AMAP_API_KEY=
AMAP_SECURITY_KEY=

# AI knowledge agent credentials: do not commit real values
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
TAVILY_API_KEY=
AI_IMAGE_MAX_MB=5
AI_IMAGE_MAX_COUNT=5
AI_REDIS_TTL_SECONDS=86400
AI_REDIS_MAX_ROUNDS=10

# Pest diagnosis RAG
BGE_M3_MODEL_PATH=backend/models/bge-m3
EMBEDDING_DIM=1024
BGE_M3_BATCH_SIZE=16
BGE_M3_MAX_LENGTH=512
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_PEST=pest_knowledge
PEST_RAG_SCORE_THRESHOLD=0.55
PEST_RAG_TOP_K=5

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
